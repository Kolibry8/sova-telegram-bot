# === Telegram Bot Token ===
# Получить у @BotFather в Telegram
TELEGRAM_TOKEN=your_token_here

# === Google Gemini API (бесплатный тариф!) ===
# Получить на https://aistudio.google.com/apikey
# Если не задан — бот будет отвечать шаблонными фразами
GEMINI_API_KEY=your_gemini_key_here

# === Имя бота (для упоминаний в чате) ===
BOT_NAME=Сова
